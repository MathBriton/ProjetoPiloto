<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>SwNet.Api</RootNamespace>
    <UserSecretsId>swnet-api-secrets</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.15" />
    <PackageReference Include="Swashbuckle.AspNetCore" Version="10.3.1" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.15">
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\SwNet.Aplicacao\SwNet.Aplicacao.csproj" />
    <ProjectReference Include="..\SwNet.Dominio\SwNet.Dominio.csproj" />
    <ProjectReference Include="..\SwNet.Infraestrutura\SwNet.Infraestrutura.csproj" />
  </ItemGroup>

</Project>
